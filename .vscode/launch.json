{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current file",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "args": ["${file}"],
            "cwd": "${workspaceFolder}",
            "sourceMaps": true,
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
        },
        {
            "name": "Debug REPL",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "args": ["${workspaceFolder}/monkey/repl.ts"],
            "cwd": "${workspaceFolder}",
            "sourceMaps": true,
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
        }
    ]
}
